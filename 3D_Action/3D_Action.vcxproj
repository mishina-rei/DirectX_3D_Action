    <MakeDir Directories="$(OutDir)Shader" />
    <Copy SourceFiles="@(RuntimeShader)" DestinationFolder="$(OutDir)Shader" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RuntimeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)GameSettings.json" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Exec Command="xcopy /D /E /I /Y &quot;$(ProjectDir)Assets&quot; &quot;$(OutDir)Assets\&quot; &gt;nul" IgnoreExitCode="true">
